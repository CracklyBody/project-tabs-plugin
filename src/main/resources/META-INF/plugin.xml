<idea-plugin>
    <id>dev.projecttabs</id>
    <name>Project Tabs</name>
    <vendor>Project Tabs</vendor>

    <description><![CDATA[
        <p>Shows every open project as a tab in the main toolbar, like documents in a word processor or pages in a browser.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.ProjectTabsBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.projecttabs.lifecycle.TabsProjectActivity"/>
        <actionPromoter implementation="dev.projecttabs.actions.ProjectTabsActionPromoter"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.projecttabs.lifecycle.TabsProjectCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <listener class="dev.projecttabs.lifecycle.TabsAppLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions resource-bundle="messages.ProjectTabsBundle">
        <action id="ProjectTabs.Toolbar" class="dev.projecttabs.ui.ProjectTabsToolbarAction">
            <add-to-group group-id="MainToolbarCenter" anchor="first"/>
        </action>

        <group id="ProjectTabs.WindowMenu" popup="true">
            <add-to-group group-id="WindowMenu" anchor="before" relative-to-action="OpenProjectWindows"/>

            <action id="ProjectTabs.Next" class="dev.projecttabs.actions.NextProjectTabAction"
                    use-shortcut-of="NextProjectWindow"/>
            <action id="ProjectTabs.Previous" class="dev.projecttabs.actions.PreviousProjectTabAction"
                    use-shortcut-of="PreviousProjectWindow"/>
            <separator/>

            <action id="ProjectTabs.GoTo1" class="dev.projecttabs.actions.GoToProjectTab1Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 1"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 1"/>
            </action>
            <action id="ProjectTabs.GoTo2" class="dev.projecttabs.actions.GoToProjectTab2Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 2"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 2"/>
            </action>
            <action id="ProjectTabs.GoTo3" class="dev.projecttabs.actions.GoToProjectTab3Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 3"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 3"/>
            </action>
            <action id="ProjectTabs.GoTo4" class="dev.projecttabs.actions.GoToProjectTab4Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 4"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 4"/>
            </action>
            <action id="ProjectTabs.GoTo5" class="dev.projecttabs.actions.GoToProjectTab5Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 5"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 5"/>
            </action>
            <action id="ProjectTabs.GoTo6" class="dev.projecttabs.actions.GoToProjectTab6Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 6"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 6"/>
            </action>
            <action id="ProjectTabs.GoTo7" class="dev.projecttabs.actions.GoToProjectTab7Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 7"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 7"/>
            </action>
            <action id="ProjectTabs.GoTo8" class="dev.projecttabs.actions.GoToProjectTab8Action">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 8"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 8"/>
            </action>
            <action id="ProjectTabs.GoToLast" class="dev.projecttabs.actions.GoToLastProjectTabAction">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt 9"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt 9"/>
            </action>
            <separator/>

            <action id="ProjectTabs.Close" class="dev.projecttabs.actions.CloseProjectTabAction"/>
            <action id="ProjectTabs.CloseOthers" class="dev.projecttabs.actions.CloseOtherProjectTabsAction"/>
            <action id="ProjectTabs.CloseToRight" class="dev.projecttabs.actions.CloseProjectTabsToRightAction"/>
            <action id="ProjectTabs.ReopenClosed" class="dev.projecttabs.actions.ReopenClosedProjectTabAction">
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt shift T"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt shift T"/>
            </action>
            <separator/>

            <action id="ProjectTabs.CopyPath" class="dev.projecttabs.actions.CopyProjectPathAction"/>
            <action id="ProjectTabs.Reveal" class="dev.projecttabs.actions.RevealProjectAction"/>
        </group>
    </actions>
</idea-plugin>
