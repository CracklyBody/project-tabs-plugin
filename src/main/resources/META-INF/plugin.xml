<idea-plugin>
    <id>dev.projecttabs</id>
    <name>Project Tabs</name>
    <vendor>Project Tabs</vendor>

    <description><![CDATA[
        <p>Shows every open project as a tab in the main toolbar, like documents in a word processor or pages in a browser.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.ProjectTabsBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.projecttabs.lifecycle.TabsProjectActivity"/>
        <actionPromoter implementation="dev.projecttabs.actions.ProjectTabsActionPromoter"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.projecttabs.lifecycle.TabsProjectCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions resource-bundle="messages.ProjectTabsBundle">
        <action id="ProjectTabs.Toolbar" class="dev.projecttabs.ui.ProjectTabsToolbarAction">
            <add-to-group group-id="MainToolbarCenter" anchor="first"/>
        </action>

        <group id="ProjectTabs.WindowMenu" popup="true">
            <add-to-group group-id="WindowMenu" anchor="before" relative-to-action="OpenProjectWindows"/>

            <action id="ProjectTabs.Next" class="dev.projecttabs.actions.NextProjectTabAction"
                    use-shortcut-of="NextProjectWindow"/>
            <action id="ProjectTabs.Previous" class="dev.projecttabs.actions.PreviousProjectTabAction"
                    use-shortcut-of="PreviousProjectWindow"/>
        </group>
    </actions>
</idea-plugin>
